# Reuse the upstream runtime/dependency image.  The frontend bundle already
# exists in that image; MCP changes are served by tsx from the copied server
# source at runtime.
FROM bekenweb/erd-builder-pro:latest

WORKDIR /app

COPY . .

# Do not rebuild Vite here.  On this host BuildKit applies a memory cgroup that
# is too small for the production bundle, while the MCP/server source does not
# require a new client bundle.
